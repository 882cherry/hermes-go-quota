+def _opencode_go_script_path():
+    global _OPENCODE_GO_SCRIPT
+    if _OPENCODE_GO_SCRIPT is not None:
+        return _OPENCODE_GO_SCRIPT
+    home = os.environ.get("HERMES_HOME") or os.path.expanduser("~/.hermes")
+    candidates = [
+        os.path.join(home, "scripts", "opencode_go_quota.py"),
+        os.path.expanduser("~/.hermes/scripts/opencode_go_quota.py"),
+    ]
+    for c in candidates:
+        if os.path.exists(c):
+            _OPENCODE_GO_SCRIPT = c
+            return c
+    _OPENCODE_GO_SCRIPT = ""
+    return None
+
+
+def _is_opencode_go_provider(user_config):
+    model_cfg = ((user_config or {}).get("model") or {})
+    provider = str(model_cfg.get("provider") or "").lower()
+    base_url = str(model_cfg.get("base_url") or "").lower()
+    return provider == "opencode-go" or "opencode.ai/zen/go" in base_url
+
+
+def _opencode_go_quota_line():
+    script = _opencode_go_script_path()
+    if not script:
+        return ""
+    try:
+        env = dict(os.environ)
+        if "HERMES_HOME" not in env:
+            env["HERMES_HOME"] = os.path.expanduser("~/.hermes")
+        proc = subprocess.run(
+            [sys.executable, script],
+            capture_output=True,
+            text=True,
+            timeout=6,
+            env=env,
+        )
+        line = (proc.stdout or "").strip()
+        return line if proc.returncode == 0 and line else ""
+    except Exception:
+        return ""
+
